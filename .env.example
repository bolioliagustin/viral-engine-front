# ═══════════════════════════════════════════════════════════════════════════
#  viral-engine — plantilla de configuración (sep 2026)
#
#  Un solo archivo `.env` en la RAÍZ del repo alimenta al backend y al worker.
#  El frontend usa `frontend/.env.local` (ver el bloque final).
#
#  Marcas:  [OBLIGATORIA]  el proceso no arranca sin ella
#           [RECOMENDADA]  funciona sin ella pero peor / más caro
#           [OPCIONAL]     dejar comentada salvo que sepas para qué es
#           [VPS]          solo importa en el VPS (docker-compose.worker.yml)
#           [MAC]          solo importa corriendo en tu Mac
#
#  Regla de oro: en tu Mac ENVIRONMENT=development (yt-dlp con tu IP
#  residencial, sin proxies ni RapidAPI); en el VPS el compose ya fuerza
#  ENVIRONMENT=production y USE_RAPIDAPI_DOWNLOAD=true.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. Supabase (backend + worker) ────────────────────────────────────────
# Dashboard → Project Settings → API. Usá el proyecto de DESARROLLO en la
# Mac y el de la beta solo en el VPS: un worker local apuntado a la beta le
# roba jobs al del VPS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co                 # [OBLIGATORIA]
SUPABASE_SERVICE_KEY=eyJ...service_role...                     # [OBLIGATORIA] service_role, NUNCA la anon


# ── 2. Entorno de ejecución ───────────────────────────────────────────────
ENVIRONMENT=development        # [OBLIGATORIA] development en la Mac | production en el VPS
MAX_WORKERS=2                  # [RECOMENDADA] jobs en paralelo (2 en Mac, 3 en VPS de 12 GB)
NODE_ENV=development           # [RECOMENDADA] backend: development | production
PORT=3000                      # [OPCIONAL] puerto del backend (en el worker solo lo usa Render)
FRONTEND_URL=http://localhost:3001   # [OBLIGATORIA] CORS y redirecciones de pago. En VPS/Render: https://viral-engine-front.vercel.app
MAX_VIDEO_MINUTES=90           # [OPCIONAL] tope de duración de la beta, en minutos. Backend (default 90, POST /process, F1): "fail open", deja pasar si no logra leer la duración.
#                                Worker (default 150, W20/A5): la autoridad; con la duración real post-transcript falla el job y devuelve el crédito.
#                                Backend y worker leen esta misma variable: si la definís en el .env del worker, ese valor también manda ahí.

# Alertas por Telegram (F1, docs/PROYECTO.md §14/§15): backend/src/lib/telegram.js.
# Bot nuevo con @BotFather (/newbot) -> copiar el token. Chat id: mandarle un
# mensaje al bot y abrir https://api.telegram.org/bot<token>/getUpdates -> chat.id.
#TELEGRAM_BOT_TOKEN=            # [RECOMENDADA] sin esto, notify() es no-op silencioso
#TELEGRAM_CHAT_ID=              # [RECOMENDADA] adonde llegan las alertas (job failed, sin créditos)


# ── 3. IA — chat (OpenRouter) ─────────────────────────────────────────────
# openrouter.ai → Keys. Todas las llamadas LLM (clasificador, Pasada A,
# Pasada B, juez) pasan por acá.
OPENROUTER_API_KEY=sk-or-v1-...                                # [OBLIGATORIA]

# Modelo por tarea. Si no seteás nada, valen los defaults de
# worker/config/model_tiers.py (los de abajo). Cambiar MODEL_ANALYSIS
# obliga a subir PROMPT_VERSION en worker/services/analysis_cache.py.
#MODEL_CLASSIFIER=google/gemini-2.5-flash-lite                 # [OPCIONAL]
#MODEL_ANALYSIS=google/gemini-3.5-flash                        # [OPCIONAL] Pasada A (selección de momentos)
#MODEL_COPY_WRITING=google/gemini-3.5-flash                    # [OPCIONAL] Pasada B (copy)
#MODEL_JUDGE=openai/gpt-5.4-nano                               # [OPCIONAL] juez cross-family
# Esfuerzo de razonamiento (solo Gemini 3.x / GPT-5.x): none | minimal | low | medium
#MODEL_ANALYSIS_REASONING=low                                  # [OPCIONAL]
#MODEL_COPY_REASONING=minimal                                  # [OPCIONAL]
#MODEL_JUDGE_REASONING=none                                    # [OPCIONAL]
# LEGACY: OPENROUTER_MODEL / OPENROUTER_COPY_MODEL / OPENROUTER_CLASSIFIER_MODEL
# siguen funcionando como fallback de MODEL_*. Si tu .env viejo tiene
# OPENROUTER_MODEL, ese es el modelo que realmente se usa: pasalo a MODEL_ANALYSIS.
#OPENROUTER_MODEL=

# Toggles del pipeline (dejar en default salvo debugging)
#TWO_PASS_ANALYSIS=true               # [OPCIONAL] false = mega-prompt legacy
#COMPACT_TRANSCRIPT=true              # [OPCIONAL] false = transcript sin compactar (más tokens)
#ENABLE_ENTERTAINMENT_CATEGORY=false  # [OPCIONAL] tercera categoría (prompt sin validar)
#LOG_LLM_USAGE=true                   # [OPCIONAL] log de tokens por llamada
#PERSIST_USAGE_EVENTS=true            # [OPCIONAL] guardar costos en job_usage_events
#PRICING_OVERRIDES_JSON={}            # [OPCIONAL] precios por modelo sin redeploy


# ── 4. IA — transcripción por clip (Whisper) ──────────────────────────────
# Groq es el preferido (word-level, ~9× más barato). Sin GROQ_API_KEY todo
# cae a OpenAI whisper-1. OPENAI_API_KEY sigue siendo obligatoria porque es
# el fallback y el único proveedor para audios de más de 20 min.
GROQ_API_KEY=gsk_...                                           # [RECOMENDADA] console.groq.com → API Keys
OPENAI_API_KEY=sk-...                                          # [OBLIGATORIA] platform.openai.com


# ── 5. YouTube — transcript y descarga de video ───────────────────────────
# Transcript del video completo (subtítulos de YouTube). Obligatoria en el
# VPS (YouTube bloquea IPs de datacenter); en la Mac también conviene tenerla.
SUPADATA_API_KEY=sd_...                                        # [OBLIGATORIA en VPS] supadata.ai
# W4 (PLAN_CALIDAD §4): fuente del Transcript que ve la Pasada A.
#   supadata     = captions de YouTube en bloques (default, comportamiento de siempre)
#   whisper_full = Whisper del audio completo por tramos: Líneas puntuadas con [mm:ss],
#                  palabras con silencios y wpm (Groq ~US$0.05 y ~1 min por 77 min);
#                  si el audio no baja, cae a captions
#   hybrid       = captions para clasificador/validaciones + Líneas de Whisper para la Pasada A
#TRANSCRIPT_SOURCE=supadata           # [OPCIONAL]
#TRANSCRIPT_PUNCTUATE_FALLBACK=true   # [OPCIONAL] false = no puntuar con el modelo barato los tramos que Whisper dejó sin puntuar
#TRANSCRIPT_LINE_STYLE=seconds        # [OPCIONAL] mmss = marca [mm:ss] por Línea (gemini-3.5-flash concatena mm y ss: no usar)

# URLs de stream vía RapidAPI (yt-api). El worker en producción NO ARRANCA
# sin esta clave (validate_env). rapidapi.com → app "YT-API" → suscripción.
RAPIDAPI_KEY=...                                               # [OBLIGATORIA en VPS] [VPS]
#USE_RAPIDAPI_DOWNLOAD=true    # [VPS] lo setea docker-compose.worker.yml; en Mac dejar sin definir

# Proxies residenciales Webshare (webshare.io → Proxy List → export).
# En el VPS el compose monta ./proxies.txt (formato http://user:pass@host:port,
# uno por línea; convertí el export con deploy/format-proxies.sh) y setea
# WEBSHARE_PROXY_FILE=/app/proxies.txt. En la Mac no hacen falta.
#WEBSHARE_PROXY_FILE=/app/proxies.txt                          # [VPS] (vía compose)
#WEBSHARE_PROXY_LIST=http://user:pass@host:port,http://...     # [OPCIONAL] alternativa inline
#WEBSHARE_PROXY_URL=http://user:pass@host:port                 # [OPCIONAL] un solo proxy (legacy)

# Cookies de YouTube para yt-dlp (refuerzo anti-bot, opcional). Exportar
# cookies.txt (Netscape) con una extensión tipo "Get cookies.txt LOCALLY"
# y pegar el base64 (o el texto plano) acá.
#YOUTUBE_COOKIES=                                              # [OPCIONAL]

# Ajustes finos de descarga (defaults en worker/main.py y downloader.py)
#DOWNLOAD_STRATEGY=auto        # [OPCIONAL] auto | full_ytdlp | upfront_partial | per_clip_parallel
#DOWNLOAD_PARALLEL_WORKERS=3   # [OPCIONAL]
#DOWNLOAD_PHASE_BUDGET_SEC=600 # [OPCIONAL]
#CLIP_MARGIN_BEFORE_SEC=15    # [OPCIONAL] margen de descarga antes del start_time (W1)
#CLIP_MARGIN_AFTER_SEC=20     # [OPCIONAL] margen de descarga después del end_time (W1)
#CLIP_KEYFRAME_MARGIN_SEC=8    # [OPCIONAL] alias legacy: setea ambos márgenes
#CLIP_SYNC_RETRIES=2           # [OPCIONAL]
#CLIP_GEN_RETRIES=1            # [OPCIONAL]
#STRICT_SYNC_VALIDATION=true   # [OPCIONAL]
#YTDLP_CLIP_FALLBACK=false     # [OPCIONAL] forzar yt-dlp per-clip aunque haya RapidAPI
#USE_APIFY_FALLBACK=false      # [OPCIONAL] descarga de clips vía Apify (pago por clip)
#APIFY_TOKEN=                  # [OPCIONAL] requerido si USE_APIFY_FALLBACK=true

# Descarga del audio completo para el Transcript (W14, docs/PLAN_CALIDAD.md):
# abandonar un proxy lento en vez de esperar media hora.
#AUDIO_SPEED_PROBE_SEC=25      # [OPCIONAL] ventana para medir el caudal antes de decidir
#AUDIO_MIN_SPEED_KBPS=200      # [OPCIONAL] piso de KB/s; por debajo, SlowProxyError (salvo >80% bajado)
#AUDIO_DOWNLOAD_ATTEMPTS=3     # [OPCIONAL] reintentos con OTRO proxy (re-resolviendo) si el primero es lento
#AUDIO_RANGE_CHUNK_BYTES=8388608  # [OPCIONAL] 8 MB — tamaño de cada tramo Range al bajar el audio (W16); pedir el archivo entero de una hace que googlevideo estrangule a ~30 KB/s
#AUDIO_TRACK_LANGUAGE=es         # [OPCIONAL] pista de audio a bajar cuando el video tiene doblaje con IA de YouTube (W17); por defecto toma el valor de TRANSCRIPT_LANGUAGE, y sin ninguno de los dos prefiere igual la pista original sobre el doblaje
#TRANSCRIPT_LANGUAGE=es          # [OPCIONAL] fija el idioma del transcript (Whisper y pista de captions de Supadata); vacío = detección automática por mayoría de tramos
#AUDIO_MAX_DOWNLOAD_SEC=1800   # [OPCIONAL] 30 min — presupuesto del intento paciente final (W14-B) si todos los proxies fueron lentos; si ni el más rápido entra, cae a captions

# Timeout dinámico del job (addendum W14): piso ≤ base + por_minuto×min_video ≤ techo.
# Ejemplos con los defaults: 14min→30 (piso), 54min→47, 77min→61, 90min→69.
#JOB_TIMEOUT_BASE_SEC=900       # [OPCIONAL] 15 min
#JOB_TIMEOUT_PER_VIDEO_MIN_SEC=36  # [OPCIONAL] 0,6 min de timeout por minuto de video
#JOB_TIMEOUT_MIN_SEC=1800       # [OPCIONAL] piso, 30 min
#JOB_TIMEOUT_MAX_SEC=4500       # [OPCIONAL] techo, 75 min


# ── 6. Cloudflare R2 — hosting de clips ───────────────────────────────────
# Cloudflare → R2 → Manage R2 API Tokens. R2_ACCOUNT_ID es el ID de cuenta
# (no la URL). R2_PUBLIC_URL es el dominio público del bucket (r2.dev o propio).
R2_ACCOUNT_ID=...                                              # [OBLIGATORIA]
R2_ACCESS_KEY_ID=...                                           # [OBLIGATORIA]
R2_SECRET_ACCESS_KEY=...                                       # [OBLIGATORIA]
R2_BUCKET_NAME=viral-engine-clips                              # [OBLIGATORIA]
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev                      # [OBLIGATORIA]


# ── 7. Facturación — Lemon Squeezy (backend) ──────────────────────────────
# Solo hacen falta para cobrar (checkout, portal, webhook). En beta pueden
# quedar las de la store actual.
LEMONSQUEEZY_API_KEY=...                                       # [RECOMENDADA]
LEMONSQUEEZY_STORE_ID=12345                                    # [RECOMENDADA]
LEMONSQUEEZY_VARIANT_ID=123456                                 # [RECOMENDADA] variante del plan Starter US$9
LEMONSQUEEZY_WEBHOOK_SECRET=...                                # [RECOMENDADA] Settings → Webhooks


# ── 8. Admin y observabilidad ─────────────────────────────────────────────
# Quién ve /admin/usage (costos por job). UUIDs de auth.users o emails.
ADMIN_EMAILS=vos@tudominio.com                                 # [RECOMENDADA]
#ADMIN_USER_IDS=uuid1,uuid2                                    # [OPCIONAL]

# Sentry (sentry.io → proyecto → DSN). Si no se setean, el código usa un DSN
# hardcodeado que se va a eliminar en la Fase 1: dejalos configurados.
SENTRY_DSN_BACKEND=https://...@o....ingest.us.sentry.io/...    # [RECOMENDADA]
SENTRY_DSN_WORKER=https://...@o....ingest.us.sentry.io/...     # [RECOMENDADA]

# Logs del worker
#LOG_LEVEL=INFO                # [OPCIONAL] DEBUG | INFO | WARNING
#LOG_FORMAT=                   # [OPCIONAL] json para logs estructurados
#WORKER_LOG_DIR=/app/logs      # [VPS] lo setea el compose; en Mac: worker/logs
#WORKER_LOG_MAX_BYTES=20971520 # [OPCIONAL]
#WORKER_LOG_BACKUP_COUNT=5     # [OPCIONAL]
# ── Rankeo de candidatos con Jev (TypeSafe System One) ───────────────────────
# RANKER=llm (default) usa la nota del Juez LLM para ordenar los candidatos.
# RANKER=jev usa Jev SOLO para el orden: el score que se guarda en
# content_results.score_judge sigue siendo el del Juez. Motivo: el Juez empata
# el 13,9 % de los pares de clips (enteros 1-10); Jev empata el 0,2 % y da una
# confianza por dimensión. Medido sobre 59 clips del golden set — ver
# worker/services/ranker_jev.py y worker/eval/jev_vs_juez.py.
# Si falta la key o la API falla, cae solo a la nota del Juez.
#RANKER=jev                    # [OPCIONAL] llm | jev
#TYPESAFE_API_KEY=             # [OPCIONAL] solo con RANKER=jev (console.typesafe.ai/keys)
#TYPESAFE_TIMEOUT_SEC=20       # [OPCIONAL]
#TYPESAFE_MAX_ATTEMPTS=3       # [OPCIONAL] reintentos ante 429/529

#FFMPEG_PATH=                  # [MAC] el ffmpeg de brew no trae libass y el render con subtítulos falla:
#FFPROBE_PATH=                 # [MAC] apuntá los dos a /opt/homebrew/opt/ffmpeg-full/bin/ (en el VPS no hace falta)
#REFRAME_MODE=off              # [OPCIONAL] off | auto — W5, encuadre Split/Fill/Fit por escena (docs/PROYECTO.md §5.5 punto 9)
#SUBTITLE_STYLE_DEFAULT=tiktok_viral_v2  # [OPCIONAL] tiktok_viral_v2|tiktok_viral|clean|podcast — W11, default ya en código (worker/main.py); documentada acá en D1 (docs/DEPLOY_FASE0.md)


# ── 9. Frontend → va en frontend/.env.local, NO en este archivo ───────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   (mismo proyecto que arriba)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...                  (Dashboard → API → anon public)
# NEXT_PUBLIC_API_URL=http://localhost:3000                    (en Vercel: la URL de Render)
#
# Para login en local, agregar http://localhost:3001/auth/callback en
# Supabase → Authentication → URL Configuration → Redirect URLs.
