# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Tiers de modelo por tarea (Plan calidad IA — Fase 1).
# Si no se setean, se usan los defaults de abajo. Evitá modelos ":free".
MODEL_ANALYSIS=google/gemini-3.5-flash
MODEL_COPY_WRITING=google/gemini-3.5-flash
MODEL_JUDGE=google/gemini-2.5-flash
MODEL_CLASSIFIER=google/gemini-2.5-flash
# Alias alternativo para copy: MODEL_COPY=google/gemini-3.5-flash
# Tier máximo análisis: MODEL_ANALYSIS=anthropic/claude-sonnet-4.5

# LEGACY (fallback si MODEL_ANALYSIS no está seteado):
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Pipeline de dos pasadas (Fase 2): selección de momentos + copy post-Whisper.
# true por defecto; false fuerza el mega-prompt legacy.
# TWO_PASS_ANALYSIS=true

# Reactivar categoría entertainment (Fase 5) — solo con pasada A estable:
# ENABLE_ENTERTAINMENT_CATEGORY=false

# OpenAI Whisper (transcripción per-clip word-level)
OPENAI_API_KEY=your-openai-api-key-here

# Groq Whisper (preferido — más rápido y barato)
# GROQ_API_KEY=your-groq-api-key-here

# ── Supabase ───────────────────────────────────────────────────────────────────
# IMPORTANTE: la variable es SUPABASE_SERVICE_KEY (no SUPABASE_KEY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── Cloudflare R2 (almacenamiento de clips) ───────────────────────────────────
# R2_ACCOUNT_ID = el ID de cuenta de Cloudflare (no la URL completa)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ── Transcripts en datacenter (OBLIGATORIO en VPS/cloud) ──────────────────────
SUPADATA_API_KEY=your-supadata-api-key-here

# ── Facturación (Lemon Squeezy) ───────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_VARIANT_ID=your-variant-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# ── Backend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
NODE_ENV=production
PORT=3000

# ── Worker ────────────────────────────────────────────────────────────────────
MAX_WORKERS=3
ENVIRONMENT=production

# Proxy residencial para bypassear IP bans de YouTube en datacenters (OBLIGATORIO en VPS)
# WEBSHARE_PROXY_URL=http://user:pass@proxy-host:port
# WEBSHARE_PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# Opcional: forzar RapidAPI en lugar de yt-dlp para descargas
# USE_RAPIDAPI_DOWNLOAD=false
# RAPIDAPI_KEY=your-rapidapi-key

# Opcional: cookies de YouTube para videos age-restricted
# YOUTUBE_COOKIES=<base64 del archivo cookies.txt>

# ── Sentry (error tracking) ───────────────────────────────────────────────────
SENTRY_DSN_BACKEND=your-sentry-dsn-backend
SENTRY_DSN_WORKER=your-sentry-dsn-worker

# ── Frontend (archivo frontend/.env.local — NO va en este .env) ──────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
