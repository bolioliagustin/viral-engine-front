# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenAI Whisper (transcripción per-clip word-level)
OPENAI_API_KEY=your-openai-api-key-here

# ── Supabase ───────────────────────────────────────────────────────────────────
# IMPORTANTE: la variable es SUPABASE_SERVICE_KEY (no SUPABASE_KEY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── Cloudflare R2 (almacenamiento de clips) ───────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ── Facturación (Lemon Squeezy) ───────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_SLUG=your-store-slug
LEMONSQUEEZY_VARIANT_ID=your-variant-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# ── Backend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
NODE_ENV=development

# ── Worker ────────────────────────────────────────────────────────────────────
MAX_WORKERS=2
# Proxy residencial para bypassear IP bans de YouTube en datacenters
# WEBSHARE_PROXY_URL=http://user:pass@proxy-host:port

# Opcional: forzar RapidAPI en lugar de yt-dlp para descargas
# USE_RAPIDAPI_DOWNLOAD=false
# RAPIDAPI_KEY=your-rapidapi-key

# Opcional: cookies de YouTube para videos age-restricted
# YOUTUBE_COOKIES=<base64 del archivo cookies.txt>

# ── Sentry (error tracking) ───────────────────────────────────────────────────
SENTRY_DSN_BACKEND=your-sentry-dsn-backend
SENTRY_DSN_WORKER=your-sentry-dsn-worker
ENVIRONMENT=development
